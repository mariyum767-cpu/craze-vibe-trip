{
  "version": 2,
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "/tours/([^/]+)", "dest": "frontend/tours/[id]?nxtPid=$1" },
    { "src": "/destinations/([^/]+)", "dest": "frontend/destinations/[id]?nxtPid=$1" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}